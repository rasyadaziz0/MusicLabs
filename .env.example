NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# CORS & App URL
ALLOWED_ORIGINS=http://localhost:3000,https://music.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AudD — Song identification
AUDD_API_TOKEN=your-audd-api-token

# Spotify OAuth / Scraper
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/spotify/callback

# Supabase Service Role Key (Admin only - never expose on client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 Storage
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ACCOUNT_ID=your-r2-account-id
R2_BUCKET_NAME=acadmusic-img
NEXT_PUBLIC_R2_DEV_URL=https://img.yourdomain.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

SECRETS_SCAN_ENABLED=true
# MAINTENANCE_MODE=false

CRON_SECRET=your-cron-secret
NEXT_PUBLIC_MUSIC_API_URL=http://localhost:4000
NEXT_PUBLIC_YTMUSIC_API_URL=http://localhost:4000
NEXT_PUBLIC_EXPRESS_API_URL=http://localhost:4000
